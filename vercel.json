{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "framework": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/_expo/(.*)", "dest": "/_expo/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
