{
  "buildCommand": "npx expo install react-dom react-native-web -- --fix && npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": "expo",
  "nodeVersion": "20.x",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/_expo/(.*)", "dest": "/_expo/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
